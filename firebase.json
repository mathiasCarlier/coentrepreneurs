{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "functions",
    "codebase": "default",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-functions-debug.log",
      ".env"
    ]
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "coentrepreneurs-7b291",
          "appId": "1:324815572845:android:1cf6f5a1303e6dd213d464",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "coentrepreneurs-7b291",
          "configurations": {
            "android": "1:324815572845:android:1cf6f5a1303e6dd213d464",
            "ios": "1:324815572845:ios:6d596f8d8849533613d464",
            "macos": "1:324815572845:ios:6d596f8d8849533613d464",
            "web": "1:324815572845:web:760a3ad54952ab2913d464",
            "windows": "1:324815572845:web:2f79064c850cd84f13d464"
          }
        }
      }
    }
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
