// 🔒 FIRESTORE SECURITY RULES
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================
    // ✅ Collection cgu_acceptances
    // ========================================
    match /cgu_acceptances/{userId} {
      allow read, write: if request.auth.uid == userId;
    }

    // ========================================
    // ✅ Collection users
    // ========================================
    match /users/{userId} {
      allow read: if request.auth.uid == userId;
      allow read: if isAuthenticated() &&
                     (canReadPublicProfile(userId) || isAdmin());
      allow update: if request.auth.uid == userId &&
                       onlyModifyingAllowedFields();
      allow read, write: if isAdmin();
      allow create: if request.auth.uid == userId;
      allow create: if request.auth == null &&
                       request.resource.data.get('role', null) == 'invite';
    }

    // ========================================
    // ✅ Collection events
    // ========================================
    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();

      // Admins peuvent tout modifier
      allow update: if isAdmin();

      // Les adhérents peuvent modifier les champs d'inscription/participation
      // (registeredUserIds, confirmedParticipants, collationParticipants, declinedUserIds)
      allow update: if isAuthenticated() &&
                       onlyModifying(['registeredUserIds', 'confirmedParticipants',
                                      'collationParticipants', 'declinedUserIds']);

      // Cloud Functions peuvent mettre à jour registeredUserIds (ajout invités)
      allow update: if request.auth == null &&
                       onlyModifying(['registeredUserIds']);
    }

    // ========================================
    // ✅ Collection feedbacks
    // ========================================
    match /feedbacks/{feedbackId} {
      // Lecture pour tous les authentifiés (nécessaire pour hasFeedback et EventFeedbackSection)
      allow read: if isAuthenticated();

      // Création : uniquement par l'auteur du feedback
      allow create: if isAuthenticated() &&
                       request.auth.uid == request.resource.data.userId;

      // Modification : uniquement par l'auteur
      allow update: if isAuthenticated() &&
                       request.auth.uid == resource.data.userId;

      // Suppression : admins uniquement
      allow delete: if isAdmin();
    }

    // ========================================
    // ✅ Collection invitations
    // ========================================
    match /invitations/{invitationId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() &&
                     request.auth.uid == resource.data.invitedByUserId;
      allow read: if isAuthenticated() &&
                     doesUserMatchInvitationEmail();
      allow update: if isAuthenticated() &&
                       doesUserMatchInvitationEmail() &&
                       onlyModifying(['status', 'respondedAt']);
      allow read, write, create, update, delete: if isAdmin();
    }

    // ========================================
    // ✅ Collection messages
    // ========================================
    match /messages/{docId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin();
      allow read: if !isAdmin() && request.auth.uid == resource.data.userId;
      allow update, delete: if isAdmin();
      allow update, delete: if request.auth.uid == resource.data.userId;
    }

    // ========================================
    // ✅ Collection notifications
    // ========================================
    match /notifications/{userId}/{notificationId} {
      allow read: if request.auth.uid == userId;
      allow create: if isAdmin();
      allow delete: if request.auth.uid == userId;
    }

    // ========================================
    // ❌ Refuser tout par défaut
    // ========================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ========================================
    // 🔧 FONCTIONS HELPER
    // ========================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function onlyModifying(fields) {
      let modifying = request.resource.data.diff(resource.data).affectedKeys();
      return modifying.hasOnly(fields);
    }

    function onlyModifyingAllowedFields() {
      let allowed = [
        'nom', 'prenom', 'phone', 'email', 'photoUrl',
        'companyName', 'skills', 'professionalAddress', 'website', 'shareProInfo'
      ];
      let modifying = request.resource.data.diff(resource.data).affectedKeys();
      return modifying.hasOnly(allowed);
    }

    function canReadPublicProfile(userId) {
      let userDoc = get(/databases/$(database)/documents/users/$(userId));
      let userRole = userDoc.data.get('role', '');
      return userRole == 'adherent' || userRole == 'admin';
    }

    function doesUserMatchInvitationEmail() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      let userEmail = userDoc.data.get('email', '');
      return resource.data['invitedUserEmail'] == userEmail;
    }
  }
}
